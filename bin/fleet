#!/usr/bin/env python3
"""Google AI Ultra Maximizer (Fleet-Hub) CLI."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

HUB_ROOT = Path(__file__).resolve().parent.parent
if str(HUB_ROOT) not in sys.path:
    sys.path.insert(0, str(HUB_ROOT))

from fleet_hub.approval_md import render_approval_center
from fleet_hub.bridges import collect_bridge_statuses, create_t3_pair_link, run_wakeup_trigger
from fleet_hub.config import detect_ai_hub, load_secrets
from fleet_hub.daemon import register_delivery, run_daemon, scan_once
from fleet_hub.db import FleetDB
from fleet_hub.mausbot_bridge import (
    apply_ultra_team,
    create_mausbot_pair_link,
    manage_mausbot_service,
    rebalance_openmausbot_models,
)
from fleet_hub.notifier import send_test_message
from fleet_hub.service_manager import fix_t3_macos_service, init_workspace, manage_service
from fleet_hub.telemetry import collect_cockpit_snapshot, invalidate_telemetry_cache, sync_gcp_credits_live
from fleet_hub.worktree import approve_task, create_isolated_worktree, request_revision, resolve_repo_map


def cmd_scan(_args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    res = scan_once(db, ai_hub)
    print(json.dumps(res, ensure_ascii=False, indent=2))
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    secrets = load_secrets()
    repos = resolve_repo_map(ai_hub)
    tasks = db.list_tasks(limit=30)
    snap = collect_cockpit_snapshot(db, ai_hub, force=True, privacy=True if getattr(args, "privacy", False) else None)

    if getattr(args, "json", False):
        print(json.dumps({"repos": len(repos), "tasks": tasks, **snap}, ensure_ascii=False, indent=2))
        return 0

    print(f"AI-Projects Hub : {ai_hub}")
    print(f"Linked Repos    : {len(repos)}")
    print(f"Triage Engine   : {'Paid Gemini API (' + secrets.gemini_triage_model + ')' if secrets.paid_api_enabled else 'Zero-Token Rules'}")
    print(f"Notifier        : {'Apprise (' + str(len(secrets.all_notify_urls())) + ' channel)' if secrets.notify_enabled else 'Not configured'}")
    print(f"Cockpit URL     : http://127.0.0.1:{secrets.fleet_port}")
    print("\n--- Open-Source Wheels ---")
    for b in snap["bridges"]:
        print(f"  {b['id']:15s}: {b['status']} | {b['detail']}")
        if b.get("bots"):
            for bot in b["bots"]:
                inst = bot.get("instance") or ""
                mod = bot.get("model") or ""
                m_str = f"{inst}/{mod}" if inst and mod else (mod or "default")
                print(f"    - {bot.get('name'):20s} -> {m_str:28s} [{bot.get('activity', 'idle')}]")
    print("\n--- Burn Advisor ---")
    for a in snap["advisor"]:
        print(f"  [{a['severity']}] {a['title']}")
    routing = snap.get("routing") or {}
    if routing:
        print(f"\n--- Routing Verdict ({routing.get('mode', '-')}) ---")
        print(f"  Coding : {routing.get('recommended_coding_model')} | Triage: {routing.get('recommended_triage_model')}")
        print(f"  Note   : {routing.get('headline_zh')}")
    print("\n--- Quota Pools (Live Telemetry) ---")
    for p in snap["pools"]:
        print(f"  {p['pool']:20s}: {p['primary']} | {p['badge']} ({p['detail']})")
    print("\n--- Tasks ---")
    if not tasks:
        print("  (none)")
    for t in tasks:
        print(f"  [{t['status']}] {t['task_id']} | {t['project']} | {t['title']} | wt={t['worktree_path'] or '-'}")
    return 0


def cmd_refresh_telemetry(_args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    snap = collect_cockpit_snapshot(db, ai_hub, force=True)
    print(json.dumps(snap, ensure_ascii=False, indent=2))
    return 0


def cmd_doctor(_args: argparse.Namespace) -> int:
    secrets = load_secrets()
    bridges = collect_bridge_statuses(secrets, force=True)
    print(json.dumps({"ai_hub": str(detect_ai_hub()), "bridges": bridges}, ensure_ascii=False, indent=2))
    return 0


def cmd_wakeup(_args: argparse.Namespace) -> int:
    ok, msg = run_wakeup_trigger()
    print(msg)
    return 0 if ok else 1


def cmd_create_worktree(args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    repos = resolve_repo_map(ai_hub)
    if args.project not in repos:
        print(f"Unknown project: {args.project}", file=sys.stderr)
        return 1
    repo_path = Path(repos[args.project]["local_path"])
    wt_path, branch, base_sha = create_isolated_worktree(repo_path, ai_hub, args.project, args.slug, args.base)
    if args.task_id and db.get_task(args.task_id):
        db.update_task_fields(
            args.task_id,
            status="RUNNING",
            worktree_path=str(wt_path),
            branch_name=branch,
            base_sha=base_sha,
        )
        db.add_event(args.task_id, "WORKTREE_CREATED", f"{branch} @ {wt_path}")
    print(json.dumps({"worktree_path": str(wt_path), "branch": branch, "base_sha": base_sha}, ensure_ascii=False))
    return 0


def cmd_register_delivery(args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    diff_stat = Path(args.diff_file).read_text(encoding="utf-8") if args.diff_file else args.diff_stat
    verify_out = Path(args.verify_file).read_text(encoding="utf-8") if args.verify_file else args.verify_output
    task = register_delivery(
        db=db,
        ai_hub=ai_hub,
        task_id=args.task_id,
        worktree_path=args.worktree,
        branch_name=args.branch,
        head_sha=args.head_sha,
        diff_stat=diff_stat,
        verify_output=verify_out,
        cost_summary=args.cost,
        title=args.title,
        project=args.project,
    )
    print(json.dumps({"ok": True, "task_id": task["task_id"], "status": task["status"]}, ensure_ascii=False))
    return 0


def cmd_approve(args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    secrets = load_secrets()
    ok, msg = approve_task(db, ai_hub, args.task_id)
    render_approval_center(db, ai_hub, secrets)
    print(msg)
    return 0 if ok else 1


def cmd_revise(args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    secrets = load_secrets()
    ok, msg = request_revision(db, args.task_id, args.note)
    render_approval_center(db, ai_hub, secrets)
    print(msg)
    return 0 if ok else 1


def cmd_notify_test(_args: argparse.Namespace) -> int:
    ok, msg = send_test_message(load_secrets())
    print(msg)
    return 0 if ok else 1


def cmd_daemon(_args: argparse.Namespace) -> int:
    run_daemon()
    return 0


def cmd_init(_args: argparse.Namespace) -> int:
    for line in init_workspace():
        print(f"✓ {line}")
    return 0


def cmd_service(args: argparse.Namespace) -> int:
    ok, msg = manage_service(args.action)
    print(msg)
    return 0 if ok else 1


def cmd_fix_t3(_args: argparse.Namespace) -> int:
    ok, msg = fix_t3_macos_service()
    print(msg)
    return 0 if ok else 1


def cmd_sync_gcp(_args: argparse.Namespace) -> int:
    ok, msg, parsed = sync_gcp_credits_live(FleetDB(), login_mode=False)
    print(json.dumps({"ok": ok, "message": msg, "data": parsed}, ensure_ascii=False, indent=2))
    return 0 if ok else 1


def cmd_gcp_login(_args: argparse.Namespace) -> int:
    ok, msg, _ = sync_gcp_credits_live(FleetDB(), login_mode=True)
    print(msg)
    return 0 if ok else 1


def cmd_maus(args: argparse.Namespace) -> int:
    secrets = load_secrets()
    if args.action == "apply-team":
        ok, msg = apply_ultra_team(secrets)
    elif args.action == "pair":
        ok, msg, _pair_url = create_mausbot_pair_link(secrets)
    else:
        ok, msg = manage_mausbot_service(args.action)
    print(msg)
    return 0 if ok else 1


def cmd_t3_pair(_args: argparse.Namespace) -> int:
    secrets = load_secrets()
    ok, msg, pair_url = create_t3_pair_link(secrets)
    print(pair_url or msg)
    return 0 if ok else 1


def cmd_rebalance(args: argparse.Namespace) -> int:
    ai_hub = detect_ai_hub()
    db = FleetDB()
    secrets = load_secrets()
    snap = collect_cockpit_snapshot(db, ai_hub, force=True)
    ok, msg, changes = rebalance_openmausbot_models(
        secrets,
        snap.get("routing") or {},
        dry_run=bool(getattr(args, "dry_run", False)),
        include_other_engines=bool(getattr(args, "include_other_engines", False)),
    )
    if not getattr(args, "dry_run", False):
        invalidate_telemetry_cache()
    if getattr(args, "json", False):
        print(json.dumps({"ok": ok, "message": msg, "routing": snap.get("routing"), "changes": changes}, ensure_ascii=False, indent=2))
    else:
        print(msg)
    return 0 if ok else 1


def main() -> int:
    parser = argparse.ArgumentParser(prog="ultra", description="Google AI Ultra Maximizer (Fleet-Hub v2.3)")
    sub = parser.add_subparsers(dest="command", required=True)

    p_scan = sub.add_parser("scan", help="Scan AI-Projects once")
    p_scan.add_argument("--once", action="store_true", help="Run a single scan")
    p_scan.set_defaults(func=cmd_scan)

    p_status = sub.add_parser("status", help="Show pools, burn advisor, wheels, and tasks")
    p_status.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    p_status.add_argument("--privacy", action="store_true", help="Mask emails and home paths")
    p_status.set_defaults(func=cmd_status)

    p_doc = sub.add_parser("doctor", help="Check installed open-source wheels (t3, agy-lens, agent-desktop, apprise)")
    p_doc.set_defaults(func=cmd_doctor)

    p_wake = sub.add_parser("wakeup", help="Warm up Antigravity 5h rolling quota window")
    p_wake.set_defaults(func=cmd_wakeup)

    p_wt = sub.add_parser("create-worktree", help="Create isolated worktree for a project")
    p_wt.add_argument("--project", required=True)
    p_wt.add_argument("--slug", required=True)
    p_wt.add_argument("--base", default="HEAD")
    p_wt.add_argument("--task-id", default="")
    p_wt.set_defaults(func=cmd_create_worktree)

    p_reg = sub.add_parser("register-delivery", help="Register worktree build for Yellow-Zone approval")
    p_reg.add_argument("--task-id", required=True)
    p_reg.add_argument("--worktree", required=True)
    p_reg.add_argument("--branch", required=True)
    p_reg.add_argument("--head-sha", required=True)
    p_reg.add_argument("--diff-stat", default="")
    p_reg.add_argument("--diff-file", default="")
    p_reg.add_argument("--verify-output", default="")
    p_reg.add_argument("--verify-file", default="")
    p_reg.add_argument("--cost", default="0-Token / local check")
    p_reg.add_argument("--title", default="")
    p_reg.add_argument("--project", default="")
    p_reg.set_defaults(func=cmd_register_delivery)

    p_app = sub.add_parser("approve", help="Approve and merge a task")
    p_app.add_argument("task_id")
    p_app.set_defaults(func=cmd_approve)

    p_rev = sub.add_parser("revise", help="Request revision on a task")
    p_rev.add_argument("task_id")
    p_rev.add_argument("note")
    p_rev.set_defaults(func=cmd_revise)

    p_nt = sub.add_parser("notify-test", help="Send an Apprise / Telegram test message")
    p_nt.set_defaults(func=cmd_notify_test)

    p_rt = sub.add_parser("refresh-telemetry", help="Refresh live probes (Antigravity, Colab, Flow, Drive, Wheels)")
    p_rt.set_defaults(func=cmd_refresh_telemetry)

    p_d = sub.add_parser("daemon", help="Run watcher daemon and cockpit HTTP server")
    p_d.set_defaults(func=cmd_daemon)

    p_init = sub.add_parser("init", help="Initialize secrets.env, workspace directories, and registry")
    p_init.set_defaults(func=cmd_init)

    p_svc = sub.add_parser("service", help="Manage background service (launchd / systemd)")
    p_svc.add_argument("action", choices=["install", "status", "restart", "uninstall"])
    p_svc.set_defaults(func=cmd_service)

    p_t3 = sub.add_parser("fix-t3-service", help="Repair macOS T3 Code LaunchAgent when T3CODE_HOME is on external SSD")
    p_t3.set_defaults(func=cmd_fix_t3)

    p_gcp = sub.add_parser("sync-gcp-credits", help="Headlessly read active GCP Billing Credits table (incl. VPS/API deductions)")
    p_gcp.set_defaults(func=cmd_sync_gcp)

    p_gcpl = sub.add_parser("gcp-login", help="Open one-time browser login for Google Cloud Billing Credits probe")
    p_gcpl.set_defaults(func=cmd_gcp_login)

    p_maus = sub.add_parser("maus", help="Manage optional OpenMausBot service, team injection, and pairing")
    p_maus.add_argument("action", choices=["install", "status", "restart", "uninstall", "apply-team", "pair"])
    p_maus.set_defaults(func=cmd_maus)

    p_t3p = sub.add_parser("t3-pair", help="Mint a fresh one-time browser pairing URL for T3 Code")
    p_t3p.set_defaults(func=cmd_t3_pair)

    p_reb = sub.add_parser("rebalance", help="Route idle OpenMausBot bots across quota pools using live telemetry")
    p_reb.add_argument("--dry-run", action="store_true", help="Preview model switches without applying")
    p_reb.add_argument("--include-other-engines", action="store_true", help="Also switch non-Antigravity bots")
    p_reb.add_argument("--json", action="store_true", help="Emit JSON output")
    p_reb.set_defaults(func=cmd_rebalance)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
