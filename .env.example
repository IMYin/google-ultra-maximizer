# Google AI Ultra Maximizer (Fleet-Hub) configuration template
# Copy to ~/.config/ultra-maximizer/secrets.env (or ~/.config/fleet-hub/secrets.env) and `chmod 600`
# Tip: You can also edit & calibrate all non-secret + secret fields directly in the Web UI (Settings modal).

# Workspace & sync directories (auto-detected if omitted)
# FLEET_WORKSPACE_ROOT=~/workspace
# FLEET_AI_HUB=~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/AI-Projects

# Cockpit HTTP port & UI language (zh | en)
FLEET_PORT=7788
FLEET_LANG=zh
T3CODE_URL=http://127.0.0.1:3773
OPENMAUSBOT_URL=http://127.0.0.1:8799
# Optional SSH config alias for an x86_64 Linux VPS (used in OpenMausBot Self-hosted VPS mode)
# VPS_SSH_ALIAS=my-gcp-vps

# Privacy mode (1 = mask email addresses and $HOME paths for screenshots/demos)
FLEET_PRIVACY_MODE=0

# Optional local proxy for Google/Telegram network access (e.g. http://127.0.0.1:1082)
# FLEET_PROXY=http://127.0.0.1:1082
# FLEET_AUTO_PROXY_PORT=1082

# Optional Apprise notification channels (comma-separated, see https://github.com/caronc/apprise)
# Examples: tgram://BOT_TOKEN/CHAT_ID, bark://KEY/HOST, discord://WEBHOOK_ID/WEBHOOK_TOKEN
# FLEET_NOTIFY_URLS=tgram://123456:ABC/987654321

# Backward-compatible Telegram shortcut (auto-converted to Apprise tgram:// URL)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional Google AI Developer Paid API key & exact monthly Credit Grant
# Leave PAID_API_MONTHLY_USD unset/0 until you verify your actual grant at:
# https://console.cloud.google.com/billing/credits (e.g. 10 for Pro, 50 for Ultra, 100 for Ultra 20x)
# GEMINI_PAID_API_KEY=
# GEMINI_TRIAGE_MODEL=gemini-2.5-flash
# PAID_API_MONTHLY_USD=50
# PAID_API_EXTERNAL_USED_USD=0

# Monthly pool baselines for progress bars
FLOW_MONTHLY_CREDITS=25000
COLAB_MONTHLY_CU=2000
